  "code": "function run(){\n const V=(d,t)=>d*10**t,wrap=d=>(d+8)%9+1, W=(d,t)=>V(wrap(d),(t+3)%3);\n const letters=[...\"אבגדהוזחטיכלמנסעפצקרשתךםןףץ\"];\n let rows=[],checks=[],fail=[],test=(id,ok)=>{checks.push(id);if(!ok)fail.push(id)};\n for(let d=1;d<=9;d++)for(let t=0;t<3;t++){\n  const v=V(d,t), h=W(d-1,t)+W(d+1,t)-2*v, expected=(d===1?9:d===9?-9:0)*10**t, vert=W(d,t-1)+W(d,t+1)-2*v, all=h+vert;\n  test(`H${d},${t}`,h===expected);test(`V${d},${t}`,vert===111*d-3*v);test(`L${d},${t}`,all===111*d-3*v+expected);\n  rows.push({d,t,letter:letters[t*9+d-1],v,h,vert,all});\n }\n let residual=letters.map((letter,i)=>{let d=i%9+1,t=Math.floor(i/9);return {letter,d,t,delta:V(d,t)-(d+9*t)-W(d,t+1)}});\n let pairs=[];for(let i=0;i<27;i++)for(let j=i;j<27;j++)if(residual[i].delta+residual[j].delta===0)pairs.push(residual[i].letter+residual[j].letter);\n test(\"unique27\",pairs.length===1&&pairs[0]===\"חק\");\n for(let t=0;t<3;t++){let s=rows.filter(x=>x.t===t).reduce((a,x)=>a+x.h,0);test(`horizontal sum ${t}`,s===0)}\n for(let d=1;d<=9;d++)test(`vertical sum ${d}`,rows.filter(x=>x.d===d).reduce((a,x)=>a+x.vert,0)===0);\n const abc=[];for(let k=0;k<=1000;k++){let v=1+9*k;abc.push(v);test(`ABC reach ${k}`,k===0?v===1:abc[k-1]+10-1===v)}\n return {rows,residual,pairs,totalPairs:27*28/2,checks:checks.length,failed:fail,abc:{seed:10,identity:1,first:abc.slice(0,6),last:abc.at(-1)},counterexample:{d:1,t:0,horizontalNeighbors:[9,2],sum:11,twiceCenter:2}};\n}\nconsole.log(JSON.stringify(run(),null,2));",
