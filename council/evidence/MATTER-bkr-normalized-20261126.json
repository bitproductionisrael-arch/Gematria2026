  "code": "function run(){\nconst L=[...\"אבגדהוזחטיכלמנסעפצקרשתךםןףץ\"], base={\"ך\":\"כ\",\"ם\":\"מ\",\"ן\":\"נ\",\"ף\":\"פ\",\"ץ\":\"צ\"};\nconst v=i=>(i%9+1)*10**Math.floor(i/9);\nconst rows=L.map((l,i)=>{const n=L.indexOf(base[l]||l);return {l,extended:v(i),regular:v(n),ordinal:n+1,next:v((i+9)%27)}});\nconst modes={extended:r=>r.extended-(L.indexOf(r.l)+1)-r.next,hybrid:r=>r.extended-r.ordinal-r.next,calculator:r=>r.regular-r.ordinal-r.next};\nconst results={};for(const [mode,f] of Object.entries(modes)){let hits=[],count=0;for(let i=0;i<27;i++)for(let j=i;j<27;j++){count++;if(f(rows[i])+f(rows[j])===0)hits.push(rows[i].l+rows[j].l)}results[mode]={count,hits,residuals:rows.map(f)}}\nreturn {rows,results};}\nconsole.log(JSON.stringify(run(),null,2));",
