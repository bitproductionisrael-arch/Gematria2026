  "code": "function run(){\n const K=18;const f=(a,b,c)=>{const N=a*b*c;let v=Array(N).fill(1n);const ns=Array.from({length:N},(_,i)=>{const x=i%a,y=Math.floor(i/a)%b,z=Math.floor(i/(a*b));return [x>0?i-1:-1,x<a-1?i+1:-1,y>0?i-a:-1,y<b-1?i+a:-1,z>0?i-a*b:-1,z<c-1?i+a*b:-1].filter(j=>j>=0)});let W=[];for(let k=0;k<=K;k++){W.push(v.reduce((s,x)=>s+x,0n));v=ns.map(js=>js.reduce((s,j)=>s+v[j],0n))}return W};\n const path=n=>{let v=Array(n).fill(1n),w=[];for(let k=0;k<=K;k++){w.push(v.reduce((s,x)=>s+x,0n));v=v.map((_,i)=>(v[i-1]??0n)+(v[i+1]??0n))}return w};\n const C=Array.from({length:K+1},(_,n)=>Array.from({length:n+1},(_,i)=>{let c=1n;for(let j=1;j<=i;j++)c=c*BigInt(n-j+1)/BigInt(j);return c}));\n const sep=(a,b,c)=>{let x=path(a),y=path(b),z=path(c);return Array.from({length:K+1},(_,k)=>{let s=0n;for(let i=0;i<=k;i++)for(let j=0;j<=k-i;j++)s+=C[k][i]*C[k-i][j]*x[i]*y[j]*z[k-i-j];return s})};\n const A=f(8,20,26),B=f(10,16,28),As=sep(8,20,26),Bs=sep(10,16,28);let checks=0;const check=(b)=>{checks++;if(!b)throw Error(\"failed \"+checks)};\n const rows=A.map((w,k)=>{check(w===As[k]);check(B[k]===Bs[k]);let L=4160n*6n**BigInt(k)-w,M=4480n*6n**BigInt(k)-B[k];if(k<=8)check(L===M);if(k===9)check(M-L===1040n);return {k,WA:String(w),WB:String(B[k]),LA:String(L),LB:String(M),delta:String(M-L)}}); \n // independent census of every small box with equal sum and pair sum; compare first separation at min unequal dimension.\n const groups=new Map();for(let a=2;a<=12;a++)for(let b=a;b<=12;b++)for(let c=b;c<=12;c++){let key=`${a+b+c},${a*b+a*c+b*c}`;if(!groups.has(key))groups.set(key,[]);groups.get(key).push([a,b,c])}\n const pairs=[];for(const g of groups.values())for(let i=0;i<g.length;i++)for(let j=i+1;j<g.length;j++){const a=g[i],b=g[j],x=sep(...a),y=sep(...b),va=BigInt(a[0]*a[1]*a[2]),vb=BigInt(b[0]*b[1]*b[2]);check(a[0]<b[0]);const k0=a[0]+1;for(let k=0;k<k0;k++)check((vb-va)*6n**BigInt(k)===y[k]-x[k]);const multiplicity=a.filter(n=>n===a[0]).length;check((vb-va)*6n**BigInt(k0)-(y[k0]-x[k0])===2n*BigInt(multiplicity)*va/BigInt(a[0]));pairs.push({a,b,k0,delta:String(2n*BigInt(multiplicity)*va/BigInt(a[0]))})}\n return {checks,rows,pairs,boxCount:[...groups.values()].reduce((s,g)=>s+g.length,0),method:\"3D adjacency dynamic programming and independent path-interleaving multinomial, BigInt\",K};\n}\nconsole.log(JSON.stringify(run(),null,2));",
